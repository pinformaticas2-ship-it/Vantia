PORT=10000
NODE_ENV=production

# Base de datos
DATABASE_URL=postgresql://postgres.dnkjcxphvrndnbmgjfco:TU_PASSWORD@aws-0-eu-west-1.pooler.supabase.com:5432/postgres
PGSSL=true
PG_FAMILY=4

# CORS: pon aquí el dominio real del frontend en Vercel (separados por coma si hay varios)
CORS_ALLOWED_ORIGINS=https://tu-frontend.vercel.app
# Opcional: patrones adicionales (substring match) además de los ya
# admitidos siempre (el propio team de Vercel, localhost, 127.0.0.1)
CORS_ALLOWED_PATTERNS=

# Clerk
CLERK_SECRET_KEY=sk_live_xxx

# IA
GEMINI_API_KEY=AIza...
# Alternativa/alias que también se acepta si GEMINI_API_KEY no está puesta
GOOGLE_API_KEY=
# Modelo de Gemini a usar para el OCR de DNI (opcional, tiene un valor por defecto en el código)
GEMINI_OCR_MODEL=
# Solo si además se usa OpenAI como proveedor de OCR/documentos
OPENAI_API_KEY=

# Correo -- cifrado en reposo de contraseñas IMAP/SMTP y de los tokens OAuth
# de Google Drive/Dropbox. Si faltan, el código cae a una clave de repuesto
# que está en el propio repositorio -- ponlas siempre en producción.
EMAIL_ENC_KEY=pon_aqui_32_caracteres_minimo
EMAIL_ENC_IV=pon_aqui_16_chars
# Envío de correo saliente propio del sistema (avisos, bienvenida a clientes...)
BREVO_API_KEY=
RESEND_API_KEY=
RESEND_FROM=
SMTP_RELAY_HOST=
SMTP_RELAY_PORT=
SMTP_RELAY_USER=
SMTP_RELAY_PASS=
# Motor externo de sincronización de correo (EmailEngine), si se usa
EMAIL_ENGINE_URL=
EMAIL_ENGINE_TOKEN=
# OAuth de Gmail/Google Calendar (además de GOOGLE_CLIENT_ID del frontend)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Dropbox (vinculación de cuenta + almacenamiento de documentos)
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=

# WhatsApp Business Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_WEBHOOK_BASE_URL=
WHATSAPP_GRAPH_VERSION=
# Solo si se prueba WhatsApp fuera del flujo normal de organización activa
WHATSAPP_ENV_ORGANIZACION_ID=

# LexNET (certificado cliente para notificaciones judiciales), si se usa
LEXNET_CLIENT_CERT_PATH=
LEXNET_CLIENT_CERT_BASE64=

# Almacenamiento en Render
START_LOCAL_FILE_WATCHER=false
DATA_ROOT=/var/data
UPLOADS_DIR=/var/data/uploads
CLIENT_FILES_PATH=/var/data/client-files
TEMP_DIR=/tmp/vantia

# Opcional
DOCPLANT_PATH=/var/data/docplant
# Vista previa de Word/Excel vía LibreOffice -- "false" la desactiva si el
# entorno no lo tiene instalado
ENABLE_LIBREOFFICE_PREVIEW=true
# Rutas a binarios de Poppler/Tesseract si no están en el PATH del sistema
PDFTOTEXT_PATH=
PDFTOPPM_PATH=
PDFTOCAIRO_PATH=
TESSERACT_PATH=
# URL pública de este backend y del frontend, usadas para construir enlaces
# (webhooks, emails, redirecciones OAuth) -- normalmente ya las da Render/Vercel
PUBLIC_BACKEND_URL=
PUBLIC_URL=

# Notificaciones push del navegador (Web Push / VAPID)
# Generar UNA VEZ con: node -e "console.log(require('web-push').generateVAPIDKeys())"
# y usar las MISMAS claves aquí y en local -- si cambian, las suscripciones ya guardadas dejan de servir.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:soporte@vantia.app

# ── No hace falta configurar estas a mano ──────────────────────────────
# Render/Railway/Vercel las inyectan solos: RENDER, RAILWAY_GIT_BRANCH,
# RAILWAY_GIT_COMMIT_SHA, VERCEL_GIT_COMMIT_REF, VERCEL_GIT_COMMIT_SHA,
# SOURCE_VERSION -- se usan para mostrar la versión desplegada en /api/health/version.
