{
  "compilerOptions": {
    "target": "es2020",
    "module": "commonjs",
    "lib": ["es2020"],
    "outDir": "./dist",
    "rootDir": "./src",
    "removeComments": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    
    /* --- REGLAS RELAJADAS PARA DESARROLLO --- */
    /* Desactivamos las reglas más estrictas para evitar bloqueos por tipos 'any' */
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": false,
    
    /* Ignorar chequeo de librerías externas que a veces fallan */
    "skipLibCheck": true,
    
    /* No molestar por variables declaradas pero no usadas (común en Express) */
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}